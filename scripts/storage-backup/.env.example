# CareTip storage backup worker — copy to a local, git-ignored .env only for safe testing.
# In production set these in the Render Cron Job's Environment settings (never commit values).

# --- Source: Supabase Storage S3 endpoint (Dashboard -> Storage -> S3 Connection) ---
SUPABASE_S3_ENDPOINT="https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="eu-central-1"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""

# --- Destination: Backblaze B2 S3-compatible endpoint ---
B2_S3_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_S3_REGION="eu-central-003"
B2_ACCESS_KEY_ID=""
B2_SECRET_ACCESS_KEY=""
B2_BUCKET="caretip-storage-backup"
# Objects land at {B2_PREFIX}/{sourceBucket}/{original key}
B2_PREFIX="supabase-storage"
# AES256 = SSE-B2 server-side encryption (default). Set "none" only if the bucket enforces its own encryption.
B2_SERVER_SIDE_ENCRYPTION="AES256"

# --- Buckets ---
# Required buckets: a missing bucket fails the run.
BACKUP_BUCKETS="caretip,caretip-official"
# Optional buckets: missing (not yet created) buckets are skipped with a warning.
BACKUP_OPTIONAL_BUCKETS=""
# Object keys in these buckets are hashed in logs.
BACKUP_SENSITIVE_BUCKETS="caretip-kyc,caretip-dsar"

# --- Tuning (optional) ---
BACKUP_CONCURRENCY="4"
BACKUP_MAX_ATTEMPTS="4"
BACKUP_BUFFER_LIMIT_BYTES="67108864"
BACKUP_REQUEST_TIMEOUT_MS="120000"
BACKUP_LIST_PAGE_SIZE="1000"
# true = list and compare only; no object reads or writes.
BACKUP_DRY_RUN="false"
