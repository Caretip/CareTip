# Supabase — copy **one** pooler URL from Dashboard → Connect (Transaction or Session).
# Avoid putting `db.*.supabase.co` in the app .env on Windows — it often causes Prisma P1001; use the pooler host only.
#
# Prisma Migrate: `npx prisma migrate deploy` often stalls on the transaction pooler (6543), and we do not use
# `directUrl` (direct host fails here). To apply a migration without deploy: open the SQL file under
# `backend/prisma/migrations/<name>/migration.sql` in Supabase → SQL Editor, run it, then from `backend/`:
#   npx prisma migrate resolve --applied <migration_folder_name>
# Example (rejected verification status) — run from repo root:
#   npm run db:migrate:resolve -- --applied 20260329120000_add_rejected_verification_status
# Or from `backend/`:
#   npm run db:migrate:resolve -- --applied 20260329120000_add_rejected_verification_status
# Or: npx prisma migrate resolve --schema prisma/schema.prisma --applied 20260329120000_add_rejected_verification_status

# Transaction pooler — use this on Render/Vercel production (required for Prisma runtime)
# Per-process pool size: DATABASE_CONNECTION_LIMIT (default 5, max 15). Raise on dedicated API servers only.
DATABASE_CONNECTION_LIMIT=5
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"

# Optional direct connection for local tooling only — NOT used by Prisma runtime (no directUrl in schema).
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Session pooler (5432) — migrations only (npm start runs migrate on 5432 via scripts/sessionDatabaseUrl.mjs).
# If you paste a 5432 URL into Render, the API auto-rewrites runtime to 6543 unless DATABASE_USE_SESSION_POOLER=true.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Required for JWT auth (use a long random string in production)
JWT_SECRET="long-random-secret-replace-in-production"
# Access token TTL (default 15m). Refresh uses HttpOnly cookie + DB rotation (see REFRESH_TOKEN_EXPIRES_DAYS).
# JWT_EXPIRES_IN="15m"
# REFRESH_TOKEN_EXPIRES_DAYS="7"
# Dev-only: Bearer fallback when refresh cookie is lost. Ignored when NODE_ENV=production.
# ALLOW_EXPIRED_ACCESS_TOKEN_REFRESH="false"

# Required for npm run admin:create (≥ 8 characters; never commit real values)
ADMIN_SEED_SECRET="long-random-secret-for-admin-creation"

# Stripe — optional until you enable card checkout / webhooks. Omit entirely for deploys that only need auth + dashboards.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_WEBHOOK_DEBUG=true
#   Log checkout webhook skip/create reasons (no secrets). Use when tips table stays empty despite 200 OK.
# Publishable key (optional on server — for future Payment Element / config; frontend may use VITE_STRIPE_PUBLISHABLE_KEY)
# STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Customer Checkout success/cancel redirects — must match the deployed SPA origin (same as users open in the browser; optional root NEXT_PUBLIC_APP_URL if you override QR base).
# Dev (Vite): http://localhost:5173 — or http://localhost:3000 if you serve the built app there
FRONTEND_URL="http://localhost:5173"

# Browser origins allowed to call the API with cookies (comma-separated). https://caretip.de and https://www.caretip.de are always allowed.
# CORS_ORIGINS="<FRONTEND_ORIGIN>"

# Ask CareTip landing assistant — feature flag (MVP default: off). When false, /api/landing-ai/chat and /events return 503.
# ENABLE_AI_ASSISTANT=false
#
# Backend overrides — see backend/.env.example
# Optional: override root REDIS_URL for local dev (empty = in-memory rate limits; production Redis is unreachable locally)
# REDIS_URL=
#
# Subscription Phase A — dual-read scaffolding (default: off). Entitlements still use Business.subscriptionTier.
# SUBSCRIPTION_V2_READS=false
# SUBSCRIPTION_BACKFILL_BATCH_SIZE=100
#
# Subscription Phase B.1 — Stripe SaaS billing (default: off). Tip checkout webhooks unchanged when disabled.
# SUBSCRIPTION_BILLING_ENABLED=false
# SUBSCRIPTION_TRIAL_ENABLED=true
#
# Required when SUBSCRIPTION_BILLING_ENABLED=true (Pro self-serve checkout + webhooks):
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Internal planKey `premium` = customer-facing Pro — env names stay PREMIUM_*:
# STRIPE_PRICE_PREMIUM_MONTHLY="price_..."   # Pro monthly (active Stripe Price on Pro product)
# STRIPE_PRICE_PREMIUM_YEARLY="price_..."    # Pro yearly
#
# Basic is internal-only (no Stripe checkout). Premium/enterprise is contact sales only.
# Legacy Basic/Enterprise Stripe price IDs are resolved from code for existing webhook events.
# OpenAI (optional). With a key, replies are AI-first with FAQ grounding.
# Without a key, or on OpenAI HTTP errors (quota, 429), /api/landing-ai/chat uses topic-aware curated fallbacks.
# Prefer LANDING_AI_OPENAI_API_KEY in production so landing traffic is isolated from other OpenAI usage.
# LANDING_AI_OPENAI_API_KEY="sk-..."
# LANDING_AI_OPENAI_MODEL="gpt-4o-mini"
# OPENAI_MODEL also works as fallback; use a chat-completions model your key supports (e.g. gpt-4o-mini).
# LANDING_AI_OPENAI_BASE_URL="https://api.openai.com/v1"

# Transactional email (Resend).
# Development: optional — user id is logged when RESEND_API_KEY is unset (no reset URL unless PASSWORD_RESET_LOG_DEV_LINK=true).
# Production (NODE_ENV=production): REQUIRED — startup fails without both vars below.
# RESEND_API_KEY="re_..."
# RESEND_FROM must be `email@domain` or `Name <email@domain>` (verified in Resend). A bare domain like `caretip.de` returns 422.
# RESEND_FROM_EMAIL is accepted as an alias for RESEND_FROM.
# RESEND_FROM="CareTip <onboarding@resend.dev>"
# RESEND_FROM="CareTip <noreply@your-verified-domain.com>"

# Dev only — log full password-reset URL when Resend is not configured (never enable in production).
# PASSWORD_RESET_LOG_DEV_LINK=false

# Google OAuth — verify ID tokens from the SPA (same Web client ID as VITE_GOOGLE_CLIENT_ID on the frontend build).
# If unset, the API falls back to VITE_GOOGLE_CLIENT_ID when both are loaded from the same root .env.
# GOOGLE_CLIENT_SECRET is not read by the API for Google login (ID-token verification only).
# Must match VITE_GOOGLE_CLIENT_ID on the frontend build exactly (same Web client ID).
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Optional during client-ID migration (comma-separated, must include the ID baked into the live SPA):
# GOOGLE_CLIENT_IDS=xxxxx.apps.googleusercontent.com,yyyyy.apps.googleusercontent.com

# Facebook Login — App ID is public; App Secret is required to verify Graph access tokens (Android).
# Limited Login JWTs (iOS) verify against FACEBOOK_APP_ID audience only.
# FACEBOOK_APP_ID=1234567890
# FACEBOOK_APP_SECRET=  # server only — never ship in the mobile app

# Apple Sign In — verify identity tokens (JWT) from iOS native AND Android/web Services ID.
# Do not put Apple private keys in the mobile app or EXPO_PUBLIC_*.
# iOS native tokens typically have aud = bundle id (de.caretip.app).
# Android/web tokens have aud = Services ID (same as VITE_APPLE_CLIENT_ID / EXPO_PUBLIC_APPLE_CLIENT_ID).
# List BOTH audiences so neither platform breaks:
# APPLE_CLIENT_IDS=de.caretip.app,<your-existing-services-id>
# Or a single value (only if it already matches every token audience you accept):
# APPLE_CLIENT_ID=
# Optional aliases used if APPLE_CLIENT_IDS / APPLE_CLIENT_ID are unset:
# APPLE_SERVICES_ID=
# APPLE_BUNDLE_ID=de.caretip.app
# Android Return URL (register this exact HTTPS URL on the existing Services ID — do not invent a new Services ID):
#   https://<PUBLIC_API_HOST>/api/auth/apple/native-callback
# If Apple requires domain verification for that host, paste the file contents here (server only):
# APPLE_DOMAIN_ASSOCIATION_CONTENT=

# Optional: extend who can sign in without clicking the inbox verification link (password or Google).
# Built-in first names include genevive, genevieve, bobby (case-insensitive; matches employee name or business name first word).
# EMAIL_VERIFICATION_BYPASS_FIRST_NAMES=pat,taylor
# EMAIL_VERIFICATION_BYPASS_EMAILS=someone@example.com,other@example.com

# Server
PORT=3001

# Profile / logo uploads (production): Supabase Storage (recommended). Create a **public** bucket named `caretip`
# (or set SUPABASE_STORAGE_BUCKET). Use the service role key only on the server — never in the SPA.
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"   # optional: omit if you only set NEXT_PUBLIC_SUPABASE_URL at repo root
# SUPABASE_SERVICE_ROLE_KEY="eyJhbG..."
# SUPABASE_STORAGE_BUCKET="caretip"
# SUPABASE_KYC_STORAGE_BUCKET="caretip-kyc"
# Optional — PostgREST bypass tests (server only, never in SPA): SUPABASE_ANON_KEY="eyJhbG..."
# Must be a single bucket id with no spaces (never "caretip official" — that breaks public logo URLs).
# Without Supabase, files are stored under ./uploads (needs persistent disk) and URLs use PUBLIC_API_BASE_URL.
# GET /api/health — public liveness ({ status, uptime, environment, database }).
# GET /health — detailed ops probe in dev (email/uploads); production returns { status: "ok" } unless x-health-secret is set.
# PUBLIC_API_BASE_URL="https://your-api.example.com"

# Error monitoring (Sentry) — optional in dev; recommended in production.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=caretip-backend@1.0.0

# Layered auth rate limits (IP caps are high for shared venue WiFi; email/invite layers catch abuse).
# Login (15 min): AUTH_LOGIN_IP_MAX_PER_15M=100 AUTH_LOGIN_EMAIL_MAX_PER_15M=20 AUTH_LOGIN_IP_EMAIL_MAX_PER_15M=10
# Register: AUTH_REGISTER_IP_MAX_PER_15M=40 AUTH_REGISTER_EMAIL_MAX_PER_HOUR=5
# Forgot password: AUTH_FORGOT_PASSWORD_IP_MAX_PER_HOUR=25 AUTH_FORGOT_PASSWORD_EMAIL_MAX_PER_HOUR=5
# Resend verification: AUTH_RESEND_VERIFICATION_IP_MAX_PER_HOUR=20 AUTH_RESEND_VERIFICATION_EMAIL_MAX_PER_HOUR=5
# Employee invite: AUTH_INVITE_IP_MAX_PER_15M=50 AUTH_INVITE_EMAIL_MAX_PER_HOUR=5 AUTH_INVITE_CODE_MAX_PER_HOUR=40

# Verbose [auth.login] console.debug (email + userExists + passwordValid; never logs password). Default on in non-production.
# AUTH_DEBUG_LOGIN=true

# Super Admin seed script extras (optional)
# ALLOW_ADMIN_SEED_IN_PRODUCTION=false
# ALLOW_MULTIPLE_SUPER_ADMINS=false

# Web push (Firebase Cloud Messaging) — optional until you enable browser notifications.
# Server: download service account JSON → save as firebase-service-account.json (gitignored), then:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Alternative (single line only — no line breaks): FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional: ENABLE_PUSH_TEST=true — allows POST /api/push/test in production (disabled by default)
# Public web config (also set VITE_FIREBASE_* at repo root for the SPA + generated service worker):
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_VAPID_KEY=   # Cloud Messaging → Web Push certificates → Key pair
# FIREBASE_AUTH_DOMAIN=     # optional — defaults to PROJECT_ID.firebaseapp.com
# FIREBASE_STORAGE_BUCKET= # optional — defaults to PROJECT_ID.appspot.com

# Legal provider webhook (IT-Recht Kanzlei XML API + legacy JSON)
# IT-Recht sends auth in the XML body as <user_auth_token> (not HTTP headers).
# LEGAL_PROVIDER_TOKEN="long-random-secret-from-legal-provider"
# Optional username/password auth instead of token:
# LEGAL_PROVIDER_USERNAME=
# LEGAL_PROVIDER_PASSWORD=
# IT-Recht module metadata returned in XML responses:
# LEGAL_IT_RECHT_MODULE_VERSION="1.0.0"
# Restrict accepted push languages/countries (comma-separated, optional):
# LEGAL_IT_RECHT_ACCOUNT_LOCALES="de,en"
# LEGAL_IT_RECHT_ACCOUNT_COUNTRIES="DE"
# Enable multishop mode (requires user_account_id on push):
# LEGAL_IT_RECHT_MULTISHOP=false
# LEGAL_IT_RECHT_ACCOUNTS_JSON='[{"accountId":"sc-1","accountName":"Main"}]'
