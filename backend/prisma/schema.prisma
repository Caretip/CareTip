// Caretip - PostgreSQL schema via Prisma
// Stormy Teal #197278 | Tomato Jam #C44536
//
// Keep this full schema (User with cuid, Business, Employee, Transaction/tips). A minimal User-only model
// would break auth, sign-in, and tipping flows.

generator client {
  provider = "prisma-client-js"
}

// Single `DATABASE_URL` — Supabase **pooler** only (`*.pooler.supabase.com`). Do not add `directUrl`:
// the direct host `db.*.supabase.co` often fails from this environment (P1001 / routing).
//
// Migrations: `npx prisma migrate deploy` may hang on the transaction pooler (port 6543). If it does, open the
// matching `prisma/migrations/*/migration.sql` in Supabase → SQL Editor, run it, then (from repo root):
//   npm run db:migrate:resolve -- --applied <migration_folder_name>
// or from `backend/` with schema path: `npx prisma migrate resolve --schema prisma/schema.prisma --applied <name>`
// so Prisma’s migration history matches the database.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  SUPER_ADMIN
}

/// GDPR lifecycle — User account state (Slice C expand). Synced with isActive for compat.
enum AccountStatus {
  active
  deactivated
  erasure_pending
  anonymized
  closed
}

/// GDPR lifecycle — Business closure / retention stage (Slice C expand).
enum BusinessLifecycle {
  active
  soft_closed
  data_restricted
  tombstoned
}

enum DataLifecycleJobType {
  erasure_continue
  anonymize_user
  anonymize_employee
  kyc_secure_destroy
  analytics_ttl
  audit_scrub
  storage_orphan_gc
  support_redact
  dsar_export
  /// Slice F-C — in-app notification TTL (fail-closed unless RETENTION_T_NOTIFY_DAYS set)
  notify_cleanup
  /// Slice F-C — guest TipFeedback PII scrub (fail-closed unless RETENTION_T_GUEST_DAYS set)
  guest_scrub
  /// Slice F-C — SubscriptionEvent payload redact (fail-closed unless RETENTION_T_BILLING_DAYS set)
  billing_redact
  /// Slice F-C — soft-removed staff identifier scrub (fail-closed unless RETENTION_T_STAFF_PII_DAYS set)
  staff_pii_scrub
  /// Strip non-essential business assets after closure + grace. Gated; does not delete financial rows.
  business_tombstone
}

enum DataLifecycleJobStatus {
  pending
  running
  succeeded
  failed
  skipped_legal_hold
  cancelled
}

/// Administrative audit trails (3-year calendar-year) vs ephemeral security logs (30 days).
/// Existing rows default to admin_audit — never apply 30-day deletion to unclassified AuditLog.
enum AuditRetentionClass {
  admin_audit
  security
}

enum BusinessVerificationStatus {
  pending
  verified
  rejected
}

/// Admin-approved platform access (separate from KYC / go-live compliance).
enum OnboardingVerificationStatus {
  draft
  submitted
  approved
  rejected
}

/// Financial / compliance document verification (separate from onboarding approval).
enum KycVerificationStatus {
  not_started
  awaiting_upload
  pending_review
  verified
  rejected
}

enum BusinessSubscriptionTier {
  basic
  premium
  enterprise
}

/// Post-onboarding operational state — separate from onboarding/KYC verification.
enum BusinessOperationalStatus {
  active
  suspended
  inactive
}

/// Platform billing plan key — aligns 1:1 with BusinessSubscriptionTier (Phase A).
enum SubscriptionPlanKey {
  basic
  premium
  enterprise
}

enum BillingCycle {
  monthly
  yearly
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid
  incomplete
}

enum TrialSource {
  internal
  stripe
}

enum SubscriptionEventProcessingResult {
  processed
  ignored
  failed
}

/// Approval-based sponsored programme access (independent of Stripe Subscription mirror).
enum SponsoredAccessStatus {
  pending
  active
  revoked
  expired
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
  not_applicable
}

enum TipStatus {
  pending
  success
  failed
}

/// Stripe Connect Express onboarding / capability mirror (Phase 1 — not tip routing).
enum StripeConnectStatus {
  not_connected
  onboarding_required
  onboarding_incomplete
  requires_information
  ready
  restricted
}

/// Stripe Payout object status for connected Express accounts (Phase 3).
/// Distinct from Transaction.payoutStatus (legacy employee tip flag).
enum StripeConnectPayoutStatus {
  pending
  in_transit
  paid
  failed
  canceled
  unknown
}

/// Balance-transaction sync against a Stripe Payout (Phase 4). Distinct from StripeConnectPayoutStatus.
enum StripeConnectPayoutReconciliationStatus {
  pending
  in_progress
  complete
  partial
  failed
}

enum GoalPeriod {
  daily
  weekly
  monthly
}

enum EmployeeGoalStatus {
  active
  archived
}

enum EmployeeInviteStatus {
  active
  expired
  revoked
}

enum EmployeeActivationStatus {
  /**
   * Fully onboarded staff (tippable / listed for customers as configured).
   */
  active
  /**
   * Added from business dashboard with activation email; awaiting password setup.
   */
  pending_activation
  /**
   * Self-signup via auth (invite code); `User.email_verified` still false until verify-email link.
   */
  pending_verification
}

enum NotificationPriority {
  normal
  high
}

/// Activity Center — event origin module (filter chip / future domain scalability).
enum ActivityEventSource {
  TIPS
  QR
  GOALS
  STAFF
  PAYMENTS
  SYSTEM
}

/// Activity Center — visual/notification weight; does not reorder chronological feed.
enum ActivityEventPriority {
  LOW
  NORMAL
  HIGH
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  technical
  billing
  kyc
  feature_request
  general
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  /**
   * Null when the account only uses social sign-in (no password set).
   */
  passwordHash           String?   @map("password_hash")
  /**
   * @deprecated Prefer OAuthAccount rows. Kept nullable for rollback/compat; no longer written.
   */
  oauthProvider          String?   @map("oauth_provider")
  /**
   * @deprecated Prefer OAuthAccount rows. Kept nullable for rollback/compat; no longer written.
   */
  oauthSubject           String?   @map("oauth_subject")
  role                   Role
  emailVerified          Boolean   @default(false) @map("email_verified")
  /**
   * Denormalized flag for platform operators; always true when role is SUPER_ADMIN.
   */
  isPlatformAdmin        Boolean   @default(false) @map("is_platform_admin")
  /**
   * When false, user cannot sign in; used to revoke access without deleting the row.
   * Kept in sync with accountStatus (active ↔ true; other states ↔ false).
   */
  isActive               Boolean   @default(true) @map("is_active")
  /**
   * Authoritative lifecycle state (Slice C). isActive remains compat mirror.
   */
  accountStatus          AccountStatus @default(active) @map("account_status")
  deletionRequestedAt    DateTime?     @map("deletion_requested_at")
  /**
   * 14-day deletion-cancellation window (DELETION_CANCELLATION_DAYS).
   * Distinct from anonymizeEligibleAt (30-day account-erasure eligibility).
   */
  deletionCancelUntil    DateTime?     @map("deletion_cancel_until")
  /**
   * 30-day account-erasure eligibility (ACCOUNT_ERASURE_GRACE_DAYS) — irreversible
   * personal-profile anonymization must not run before this instant.
   */
  anonymizeEligibleAt    DateTime?     @map("anonymize_eligible_at")
  anonymizedAt           DateTime?     @map("anonymized_at")
  closedAt               DateTime?     @map("closed_at")
  /**
   * Orchestration wake-up helper only — NOT legal authority for category retention (Amendment A1).
   */
  nextLifecycleWakeAt    DateTime?     @map("next_lifecycle_wake_at")
  legalHold              Boolean       @default(false) @map("legal_hold")
  legalHoldReason        String?       @map("legal_hold_reason") @db.Text
  /** Category-specific hold (e.g. financial, kyc, audit, support). Empty = no category hold. */
  legalHoldCategories    String[]      @default([]) @map("legal_hold_categories")
  legalHoldSetAt         DateTime?     @map("legal_hold_set_at")
  /** Platform-admin actor id who last set the hold (Amendment A2/A3 — id only, no email). */
  legalHoldSetByUserId   String?       @map("legal_hold_set_by_user_id")
  /** Last release (Admin only). Kept after legalHold=false for audit. */
  legalHoldReleasedAt    DateTime?     @map("legal_hold_released_at")
  legalHoldReleasedByUserId String?    @map("legal_hold_released_by_user_id")
  legalHoldReleaseReason String?       @map("legal_hold_release_reason") @db.Text
  /**
   * HMAC of normalized email after anonymize — PSEUDONYMIZED residual (Amendment A5), not anonymous.
   */
  emailHash              String?       @map("email_hash")
  /**
   * Business-only: whether the manager finished onboarding.
   * Controls post-auth routing to `/onboarding`.
   */
  hasCompletedOnboarding Boolean   @default(false) @map("has_completed_onboarding")
  /**
   * Set only when the manager explicitly finishes onboarding (PATCH /api/auth/me).
   */
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")
  /**
   * UI + transactional email language: `en` or `de`. Null until user picks a language or registers with a locale hint.
   */
  preferredLocale        String?   @map("preferred_locale")
  /**
   * Incremented on password change and refresh-token reuse — access JWT `tv` must match.
   */
  authTokenVersion       Int       @default(0) @map("auth_token_version")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  business                Business?
  employee                Employee?
  oauthAccounts           OAuthAccount[]
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mobileWebHandoffTokens  MobileWebHandoffToken[]
  refreshTokens           RefreshToken[]
  settings                UserSettings?
  pushDeviceTokens        PushDeviceToken[]
  notifications           Notification[]
  setupNotificationStates SetupNotificationState[]
  announcementsCreated    Announcement[]           @relation("AnnouncementCreatedBy")
  supportTicketsCreated   SupportTicket[]          @relation("SupportTicketCreatedBy")
  supportTicketMessages   SupportTicketMessage[]   @relation("SupportTicketMessageAuthor")
  physicalQrOrderMessages PhysicalQrOrderMessage[] @relation("PhysicalQrOrderMessageAuthor")
  physicalQrOrderNotes    PhysicalQrOrderInternalNote[] @relation("PhysicalQrOrderNoteAuthor")
  employeeInvitesCreated  EmployeeInvite[]         @relation("EmployeeInvitesCreated")
  employeeInviteRedemptions EmployeeInviteRedemption[] @relation("EmployeeInviteRedemptions")
  sponsoredAccessGrantsApproved SponsoredAccessGrant[] @relation("SponsoredAccessGrantsApproved")
  physicalQrOrders        PhysicalQrOrder[]

  /**
   * Account-level security features (optional; does not change auth flow unless enforced).
   */
  twoFactorEnabled    Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret     String? @map("two_factor_secret")
  twoFactorTempSecret String? @map("two_factor_temp_secret")

  @@unique([oauthProvider, oauthSubject], map: "User_oauth_provider_subject_key")
  @@index([createdAt(sort: Desc)])
}

/**
 * Linked identity providers (Google / Apple / Facebook).
 * One CareTip user may link multiple providers; each provider subject is globally unique.
 */
model OAuthAccount {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  provider    String
  subject     String
  emailAtLink String?  @map("email_at_link")
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject], map: "OAuthAccount_provider_subject_key")
  @@unique([userId, provider], map: "OAuthAccount_user_provider_key")
  @@index([userId])
  @@map("oauth_accounts")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /**
   * Email / in-app preferences
   */
  tipReceivedNotifications Boolean @default(true) @map("tip_received_notifications")
  summaryEmails            Boolean @default(false) @map("summary_emails")
  systemAlerts             Boolean @default(true) @map("system_alerts")
  notifyNewLogin           Boolean @default(true) @map("notify_new_login")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// FCM web push registration for a signed-in user (browser/device).
model PushDeviceToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  /**
   * FCM registration token from the browser.
   */
  token      String   @unique
  platform   String   @default("web")
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_device_tokens")
}

/// In-app notification inbox (push/email are delivery channels on the row).
model Notification {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  type      String               @db.VarChar(64)
  title     String               @db.VarChar(256)
  message   String               @db.Text
  metadata  Json                 @default("{}")
  priority  NotificationPriority @default(normal)
  /**
   * Channels used for this delivery: in_app, push, email
   */
  channels  String[]             @default(["in_app"])
  readAt    DateTime?            @map("read_at")
  /**
   * Optional dedupe key per user (e.g. tip:id:employee:userId).
   */
  dedupeKey String?              @map("dedupe_key") @db.VarChar(191)
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Class S setup-prompt lifecycle (Stripe / verification / missing QR / profile photo).
/// Not inbox rows — contextual UI only. Unique per user + logical key.
enum SetupNotificationStatus {
  active
  dismissed
  actioned
  resolved
}

model SetupNotificationState {
  id              String                   @id @default(cuid())
  userId          String                   @map("user_id")
  /**
   * Stable identity, e.g. setup:stripe_connect:business:{businessId}
   */
  notificationKey String                   @map("notification_key") @db.VarChar(191)
  businessId      String?                  @map("business_id")
  status          SetupNotificationStatus  @default(active)
  /**
   * Condition fingerprint (e.g. not_ready, pending, rejected). Change → new ACTIVE cycle.
   */
  conditionVersion String                  @map("condition_version") @db.VarChar(64)
  dismissedAt     DateTime?                @map("dismissed_at")
  remindAt        DateTime?                @map("remind_at")
  actionedAt      DateTime?                @map("actioned_at")
  resolvedAt      DateTime?                @map("resolved_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([userId, status])
  @@map("setup_notification_states")
}

/// Platform admin broadcast audit record.
model Announcement {
  id             String               @id @default(cuid())
  createdById    String?              @map("created_by_id")
  title          String               @db.VarChar(256)
  message        String               @db.Text
  audience       String               @db.VarChar(32)
  priority       NotificationPriority @default(normal)
  channels       String[]             @default(["in_app", "push"])
  url            String?              @db.VarChar(512)
  recipientCount Int                  @default(0) @map("recipient_count")
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at")

  createdBy User? @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("announcements")
}

/// Business → platform support request (thread body in SupportTicketMessage).
model SupportTicket {
  id              String                @id @default(cuid())
  ticketNumber    String                @unique @map("ticket_number") @db.VarChar(32)
  businessId      String                @map("business_id")
  createdByUserId String?               @map("created_by_user_id")
  subject         String                @db.VarChar(256)
  category        SupportTicketCategory
  status          SupportTicketStatus   @default(OPEN)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  closedAt        DateTime?             @map("closed_at")

  business  Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("SupportTicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages  SupportTicketMessage[]

  @@index([businessId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String   @id @default(cuid())
  ticketId     String   @map("ticket_id")
  authorUserId String?  @map("author_user_id")
  /**
   * `business` (manager) or `admin` (platform operator).
   */
  authorRole   String   @map("author_role") @db.VarChar(16)
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// Long-lived refresh tokens for session continuity (hashed at rest; rotated on every use).
model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenReplacedBy", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken[] @relation("RefreshTokenReplacedBy")

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// One-time consume of MFA login challenge JWTs (`jti`). Unique insert is the distributed lock.
model ConsumedMfaChallenge {
  jti       String   @id @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("consumed_mfa_challenges")
}

/// One-time tokens for email password recovery (stores SHA-256 of the secret segment).
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One-time tokens for email verification (stores SHA-256 of the secret segment).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// One-time mobile→web session handoff (SHA-256 of secret). Short TTL; claim via consumedAt.
model MobileWebHandoffToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id")
  /// Allowlisted destination purpose, e.g. `billing` — never a client redirect path.
  purpose           String    @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  consumedAt        DateTime? @map("consumed_at")
  createdIp         String?   @map("created_ip") @db.VarChar(64)
  createdUserAgent  String?   @map("created_user_agent") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("mobile_web_handoff_tokens")
}

/// One-time activation tokens for employee account setup (stores SHA-256 of the secret segment).
/// Allows employee to set their own password after being added by business.
model EmployeeActivationToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  employeeId String   @map("employee_id")
  email      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_activation_tokens")
}

/// Security / compliance trail for sensitive actions (especially platform admin).
model AuditLog {
  id             String              @id @default(cuid())
  action         String
  userId         String?             @map("user_id")
  metadata       String?             @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  /**
   * Default admin_audit (3-year calendar-year). Do not apply 30-day security TTL here.
   */
  retentionClass AuditRetentionClass @default(admin_audit) @map("retention_class")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([retentionClass, createdAt])
  @@map("audit_logs")
}

model StripeWebhookEvent {
  id          String   @id
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("stripe_webhook_events")
}

/// Stripe Connect Express payout to a connected account's external bank/card.
/// Observation-only — CareTip does not initiate Stripe payouts. Not Transaction.payoutStatus.
model StripeConnectPayout {
  id                     String                    @id @default(cuid())
  businessId             String                    @map("business_id")
  stripeAccountId        String                    @map("stripe_account_id")
  stripePayoutId         String                    @unique @map("stripe_payout_id")
  amountCents            Int                       @map("amount_cents")
  currency               String                    @db.VarChar(8)
  status                 StripeConnectPayoutStatus
  arrivalDate            DateTime?                 @map("arrival_date")
  method                 String?                   @db.VarChar(32)
  payoutType             String?                   @map("payout_type") @db.VarChar(32)
  description            String?                   @db.VarChar(255)
  failureCode            String?                   @map("failure_code") @db.VarChar(64)
  failureMessage         String?                   @map("failure_message") @db.VarChar(255)
  stripeCreatedAt        DateTime                  @map("stripe_created_at")
  lastStripeEventCreated Int                       @map("last_stripe_event_created")
  lastStripeEventType    String                    @map("last_stripe_event_type") @db.VarChar(64)
  lastStripeEventId      String?                   @map("last_stripe_event_id") @db.VarChar(128)
  paidAt                 DateTime?                 @map("paid_at")
  failedAt               DateTime?                 @map("failed_at")
  canceledAt             DateTime?                 @map("canceled_at")
  reconciliationStatus        StripeConnectPayoutReconciliationStatus @default(pending) @map("reconciliation_status")
  reconciliationCursor        String?                                 @map("reconciliation_cursor") @db.VarChar(128)
  reconciliationHasMore       Boolean                                 @default(true) @map("reconciliation_has_more")
  reconciliationAttemptCount  Int                                     @default(0) @map("reconciliation_attempt_count")
  reconciliationLastError     String?                                 @map("reconciliation_last_error") @db.VarChar(255)
  reconciliationLastAttemptAt DateTime?                               @map("reconciliation_last_attempt_at")
  reconciliationCompletedAt   DateTime?                               @map("reconciliation_completed_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  business     Business                           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  balanceLines StripeConnectPayoutBalanceLine[]

  @@index([businessId, stripeCreatedAt(sort: Desc)])
  @@index([businessId, status])
  @@index([stripeAccountId])
  @@index([status, stripeCreatedAt(sort: Desc)])
  @@index([reconciliationStatus, reconciliationLastAttemptAt])
  @@map("stripe_connect_payouts")
}

/// Stripe balance transactions that contributed to a connected-account payout.
/// A payout is not 1:1 with a CareTip tip — lines may include charges, refunds, fees, adjustments.
model StripeConnectPayoutBalanceLine {
  id                         String   @id @default(cuid())
  payoutId                   String   @map("payout_id")
  stripeBalanceTransactionId String   @unique @map("stripe_balance_transaction_id")
  reportingCategory          String?  @map("reporting_category") @db.VarChar(64)
  type                       String   @db.VarChar(64)
  amountCents                Int      @map("amount_cents")
  feeCents                   Int      @map("fee_cents")
  netCents                   Int      @map("net_cents")
  currency                   String   @db.VarChar(8)
  createdAtStripe            DateTime @map("created_at_stripe")
  createdAt                  DateTime @default(now()) @map("created_at")

  payout StripeConnectPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
  @@map("stripe_connect_payout_balance_lines")
}

model Business {
  id                  String    @id @default(cuid())
  name                String
  /**
   * Public URL segment for team QR: /business/{slug} — required for directory queries & pooler consistency
   */
  slug                String    @unique @map("slug")
  inviteCode          String?   @unique @map("invite_code")
  inviteCodeExpiresAt DateTime? @map("invite_code_expires_at")
  /// Stripe Connect Express connected account (`acct_...`). Unique — one Business ↔ one Connect account.
  stripeAccountId     String?   @unique @map("stripe_account_id")
  /// CareTip-facing Connect status derived from Stripe account capabilities/requirements.
  stripeConnectStatus StripeConnectStatus @default(not_connected) @map("stripe_connect_status")
  stripeChargesEnabled Boolean @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled Boolean @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted Boolean @default(false) @map("stripe_details_submitted")
  /// Stripe `requirements.disabled_reason` when present (safe short code/string).
  stripeConnectDisabledReason String? @map("stripe_connect_disabled_reason") @db.VarChar(128)
  /// Count of `requirements.currently_due` items (not the raw list).
  stripeConnectRequirementsDue Int @default(0) @map("stripe_connect_requirements_due")
  stripeConnectUpdatedAt DateTime? @map("stripe_connect_updated_at")
  /// Platform Stripe Customer for checkout reuse before a Subscription row exists (Option A).
  stripeCustomerId    String?   @unique @map("stripe_customer_id")
  userId              String    @unique @map("user_id")
  /**
   * IANA timezone used for all dashboard analytics/ranges (e.g. "Europe/Berlin").
   * Timestamps are stored in UTC; queries translate business-local boundaries to UTC.
   */
  timezone            String    @default("Europe/Berlin") @map("timezone")

  verificationStatus       BusinessVerificationStatus @default(pending) @map("verification_status")
  onboardingVerificationStatus OnboardingVerificationStatus @default(draft) @map("onboarding_verification_status")
  kycVerificationStatus    KycVerificationStatus    @default(not_started) @map("kyc_verification_status")
  onboardingSubmittedAt    DateTime?                @map("onboarding_submitted_at")
  onboardingReviewNotes    String?                  @map("onboarding_review_notes") @db.Text
  onboardingReviewHistory  Json?                    @map("onboarding_review_history")
  taxId                    String?                    @map("tax_id")
  legalContactName         String?                    @map("legal_contact_name")
  contactEmail             String?                    @map("contact_email")
  contactPhone             String?                    @map("contact_phone")
  website                  String?                    @map("website")
  registeredAddress        String?                    @map("registered_address") @db.Text
  /**
   * Business type selected during sign-up (e.g. "Restaurant", "Salon", "Hotel", etc).
   */
  businessType             String?                    @map("business_type")
  /**
   * Business location selected during sign-up.
   */
  location                 String?                    @map("location")
  /**
   * Public URL path served under /uploads (e.g. /uploads/platform/businesses/{id}/logo-….png).
   */
  logoPath                 String?                    @map("logo_path")
  /** Premium branding — hero banner on guest landing (public URL). */
  bannerImagePath          String?                    @map("banner_image_path")
  /** Premium branding — QR frame / guest accent (HEX). */
  brandPrimaryColor        String?                    @default("#EB992C") @map("brand_primary_color") @db.VarChar(7)
  brandSecondaryColor      String?                    @default("#000000") @map("brand_secondary_color") @db.VarChar(7)
  /** Premium — guest header welcome line (max 120 chars). */
  welcomeMessage           String?                    @map("welcome_message") @db.VarChar(120)
  /** Premium — post-tip thank-you copy (max 250 chars). */
  thankYouMessage          String?                    @map("thank_you_message") @db.VarChar(250)
  /** Premium v2 — guest-facing display name (QR + tipping); falls back to `name`. */
  brandDisplayName         String?                    @map("brand_display_name") @db.VarChar(80)
  /** Premium v2 — short tagline under display name on QR and guest pages. */
  brandTagline             String?                    @map("brand_tagline") @db.VarChar(120)
  /** Premium v2 — QR visual template preset. */
  qrTemplate               String                     @default("velvet-lounge-noir") @map("qr_template") @db.VarChar(32)
  /** Premium v2 — QR card border style. */
  qrBorderStyle            String                     @default("rounded") @map("qr_border_style") @db.VarChar(32)
  /** Premium v2 — QR module container shape. */
  qrShape                  String                     @default("square") @map("qr_shape") @db.VarChar(32)
  /** Premium v2 — QR frame/accent (falls back to brandPrimaryColor). */
  qrAccentColor            String?                    @map("qr_accent_color") @db.VarChar(7)
  /** Premium v2 — QR card background. */
  qrBackgroundColor        String?                    @default("#FFFFFF") @map("qr_background_color") @db.VarChar(7)
  /**
   * KYC / verification document path under /uploads.
   */
  verificationDocumentPath String?                    @map("verification_document_path")
  /**
   * Manager-uploaded KYC bundle: registration, address, governmentId, additional[].
   */
  kycDocuments             Json?                      @map("kyc_documents")
  kycSubmittedAt           DateTime?                  @map("kyc_submitted_at")
  kycReviewNotes           String?                    @map("kyc_review_notes") @db.Text
  kycReviewHistory         Json?                      @map("kyc_review_history")
  /**
   * Mirrored SaaS tier for read-optimized UI. Not authoritative for authorization — use Subscription + resolver.
   * Null when the business has no active subscription (Option A).
   */
  subscriptionTier         BusinessSubscriptionTier?  @map("subscription_tier")
  operationalStatus        BusinessOperationalStatus  @default(active) @map("operational_status")
  operationalStatusChangedAt DateTime?                @map("operational_status_changed_at")
  operationalReviewHistory Json?                      @map("operational_review_history")
  deletedAt                DateTime?                  @map("deleted_at")
  /** GDPR lifecycle stage (Slice C expand). deletedAt remains soft-close compat. */
  lifecycleStatus          BusinessLifecycle          @default(active) @map("lifecycle_status")
  anonymizedAt             DateTime?                  @map("anonymized_at")
  /**
   * Orchestration helpers from category policy — NOT sole tombstone authority (Amendment A1/A6).
   */
  kycRetainUntil           DateTime?                  @map("kyc_retain_until")
  financialRetainUntil     DateTime?                  @map("financial_retain_until")
  legalHold                Boolean                    @default(false) @map("legal_hold")
  legalHoldReason          String?                    @map("legal_hold_reason") @db.Text
  legalHoldCategories      String[]                   @default([]) @map("legal_hold_categories")
  legalHoldSetAt           DateTime?                  @map("legal_hold_set_at")
  /** Platform-admin actor id who last set the hold (Amendment A2/A3 — id only, no email). */
  legalHoldSetByUserId     String?                    @map("legal_hold_set_by_user_id")
  legalHoldReleasedAt      DateTime?                  @map("legal_hold_released_at")
  legalHoldReleasedByUserId String?                   @map("legal_hold_released_by_user_id")
  legalHoldReleaseReason   String?                    @map("legal_hold_release_reason") @db.Text
  /** Set when non-essential assets are stripped; financial/Stripe mapping retained. */
  tombstonedAt             DateTime?                  @map("tombstoned_at")
  /**
   * Albertina Pro monthly free physical-QR order. Null = never used.
   * Concurrent checkouts claim with UPDATE … WHERE unused this calendar month.
   */
  physicalQrFreeOrderUsedAt DateTime?                 @map("physical_qr_free_order_used_at")
  /** Venue / business creation time — platform growth SSOT (not manager user proxy). */
  createdAt                DateTime                   @default(now()) @map("created_at")

  /// Slice D: Restrict — owner User cannot be deleted while Business exists.
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  employees      Employee[]
  transactions   Transaction[]
  tipRefunds     TipRefund[]
  stripeConnectPayouts StripeConnectPayout[]
  locations      Location[]
  supportTickets SupportTicket[]
  employeeInvites EmployeeInvite[]
  subscription   Subscription?
  sponsoredAccessGrants SponsoredAccessGrant[]
  qrScanEvents   QrScanEvent[]
  qrGuestVisits  QrGuestVisit[]
  qrFunnelEvents QrFunnelEvent[]
  featureUtilizationDaily FeatureUtilizationDaily[]
  activityEvents BusinessActivityEvent[]
  physicalQrOrders PhysicalQrOrder[]

  @@index([verificationStatus], map: "businesses_verification_status_idx")
  @@index([onboardingVerificationStatus], map: "businesses_onboarding_verification_status_idx")
  @@index([kycVerificationStatus], map: "businesses_kyc_verification_status_idx")
  @@index([operationalStatus], map: "businesses_operational_status_idx")
  @@index([deletedAt], map: "businesses_deleted_at_idx")
  @@index([createdAt(sort: Desc)], map: "businesses_created_at_idx")
  @@map("businesses")
}

/// Explicit approved sponsored programme grant — never inferred from businessType.
model SponsoredAccessGrant {
  id                 String                @id @default(cuid())
  businessId         String                @map("business_id")
  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  programmeKey       String                @map("programme_key")
  capabilityProfileKey String?               @map("capability_profile_key")
  status             SponsoredAccessStatus @default(pending)
  approvedAt         DateTime?             @map("approved_at")
  approvedByUserId   String?               @map("approved_by_user_id")
  approvedBy         User?                 @relation("SponsoredAccessGrantsApproved", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  expiresAt          DateTime?             @map("expires_at")
  notes              String?               @db.Text
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([businessId, status])
  @@index([programmeKey, status])
  @@map("sponsored_access_grants")
}

/// Manager-generated employee invite codes (multi-use until expiry or rotation).
model EmployeeInvite {
  id              String               @id @default(cuid())
  inviteCode      String               @unique @map("invite_code")
  businessId      String               @map("business_id")
  createdByUserId String               @map("created_by_user_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  expiresAt       DateTime             @map("expires_at")
  status          EmployeeInviteStatus @default(active)

  business    Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   User                       @relation("EmployeeInvitesCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  redemptions EmployeeInviteRedemption[]

  @@index([businessId, status])
  @@index([expiresAt])
  @@map("employee_invites")
}

/// One row per employee who joins via an invite code (audit + redemption history).
model EmployeeInviteRedemption {
  id               String   @id @default(cuid())
  inviteId         String   @map("invite_id")
  redeemedByUserId String   @map("redeemed_by_user_id")
  redeemedAt       DateTime @default(now()) @map("redeemed_at")
  employeeId       String   @map("employee_id")
  inviteeEmail     String   @map("invitee_email")
  inviteeName      String   @map("invitee_name")

  invite     EmployeeInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  redeemedBy User           @relation("EmployeeInviteRedemptions", fields: [redeemedByUserId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([inviteId, redeemedByUserId])
  @@index([inviteId, redeemedAt])
  @@index([redeemedByUserId])
  @@map("employee_invite_redemptions")
}

model Location {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  businessId   String        @map("business_id")
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tables       Table[]
  transactions Transaction[]
  employees    Employee[]
  qrScanEvents QrScanEvent[]

  @@index([businessId])
  @@map("locations")
}

model Table {
  id                       String                    @id @default(cuid())
  name                     String
  /**
   * Unique segment for guest URLs: GET /api/tipping-context/:qrSlug
   */
  qrSlug                   String                    @unique @map("qr_slug")
  locationId               String                    @map("location_id")
  location                 Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  transactions             Transaction[]
  employeeTableAssignments EmployeeTableAssignment[]
  qrScanEvents             QrScanEvent[]

  /// Tables are always listed/counted via location (and location.businessId join).
  @@index([locationId])
  @@map("venue_tables")
}

/// Explicit join for Employee ↔ venue `Table` (Postgres `_EmployeeTableAssignments`, columns A/B).
/// Named explicitly so Prisma matches `db push` / Supabase — implicit M2M used `_EmployeeToTable` and caused P2021.
/// `employeeName` denormalizes `employees.name` for audit / SQL without joining `employees`.
model EmployeeTableAssignment {
  employeeId   String @map("A")
  tableId      String @map("B")
  employeeName String @map("employee_name")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  table    Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@id([employeeId, tableId])
  @@index([tableId], map: "_EmployeeTableAssignments_B_index")
  @@map("_EmployeeTableAssignments")
}

model Employee {
  id                 String                   @id @default(cuid())
  name               String
  slug               String?                  @unique
  jobTitle           String                   @map("job_title")
  bio                String?                  @db.Text
  avatar             String?
  phone              String?
  monthlyGoal        Decimal?                 @map("monthly_goal") @db.Decimal(10, 2)
  emailNotifications Boolean                  @default(true) @map("email_notifications")
  pushNotifications  Boolean                  @default(true) @map("push_notifications")
  isActive           Boolean                  @default(true) @map("is_active")
  /**
   * Soft delete — membership_removed. Tips must survive (do not hard-delete User for Art. 17).
   * Art. 17 completion uses anonymizedAt (membership_anon) in a later slice.
   */
  isDeleted          Boolean                  @default(false) @map("is_deleted")
  deletedAt          DateTime?                @map("deleted_at")
  anonymizedAt       DateTime?                @map("anonymized_at")
  /**
   * `active` = ready for work flows; `pending_activation` = dashboard invite, needs `/activate`;
   * `pending_verification` = auth-page invite signup, needs email verification.
   */
  activationStatus   EmployeeActivationStatus @default(active) @map("activation_status")
  businessId         String                   @map("business_id")
  /**
   * Linked auth account. Nullable after anonymization / user detach (Slice D SetNull).
   * New hires still create a User; absence of userId means membership stub for tip history.
   */
  userId             String?                  @unique @map("user_id")
  /**
   * Optional venue for multi-QR flows; must belong to the same business.
   */
  locationId         String?                  @map("location_id")

  business         Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  location         Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  transactions     Transaction[]
  tableAssignments EmployeeTableAssignment[]
  employeeGoals    EmployeeGoal[]
  activationTokens EmployeeActivationToken[]
  inviteRedemptions EmployeeInviteRedemption[]
  qrScanEvents      QrScanEvent[]

  @@index([businessId, locationId])
  @@index([businessId, isActive, name])
  @@index([businessId, isDeleted])
  @@map("employees")
}

/// Employee-created tip goals (multiple rows per employee). Business has read-only visibility via stats API.
model EmployeeGoal {
  id         String             @id @default(cuid())
  employeeId String             @map("employee_id")
  name       String             @default("Tip goal")
  goalAmount Decimal            @map("goal_amount") @db.Decimal(10, 2)
  goalPeriod GoalPeriod         @map("goal_period")
  status     EmployeeGoalStatus @default(active)
  startDate  DateTime           @map("start_date") @db.Date
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, status, updatedAt(sort: Desc)])
  @@map("employee_goals")
}

/// Payment / tip transaction (Stripe PaymentIntent). DB table remains `tips` for zero-downtime migrations.
/// Optional locationId/tableId: physical table QR context only — never required for auth.
model Transaction {
  id                    String       @id @default(cuid())
  amount                Decimal      @db.Decimal(10, 2)
  status                TipStatus    @default(pending)
  stripePaymentIntentId String?      @unique @map("stripe_payment_intent_id")
  /** Customer-facing receipt reference (e.g. CT-26-A8K4P9X2). Assigned when status becomes success. */
  receiptNumber         String?      @unique @map("receipt_number")
  payoutStatus          PayoutStatus @default(not_applicable) @map("payout_status")
  /// Nullable after staff detach/erasure (Slice D) — tip financial row must survive.
  employeeId            String?      @map("employee_id")
  businessId            String       @map("business_id")
  locationId            String?      @map("location_id")
  tableId               String?      @map("table_id")
  createdAt             DateTime     @default(now()) @map("created_at")

  employee Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// Slice D.1: Restrict — prevent accidental cascade wipe of financial history.
  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  table    Table?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  feedback TipFeedback?
  tipRefunds TipRefund[]

  @@index([businessId])
  @@index([employeeId, status, createdAt(sort: Desc)])
  @@index([businessId, status, createdAt(sort: Desc)])
  @@index([employeeId, status, payoutStatus])
  @@map("tips")
}

/// Legacy sequential counter table (CT-YYYY-NNNNN). Unused by current secure allocator; retained for existing DB rows.
model TipReceiptSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("tip_receipt_sequences")
}

/// Optional customer feedback tied to a *successful* tip transaction.
/// Public pages submit feedback using the Stripe Checkout session id, which the API
/// validates and maps to `Transaction` via payment_intent.
model TipFeedback {
  id                      String  @id @default(cuid())
  transactionId           String  @unique @map("transaction_id")
  businessId              String  @map("business_id")
  employeeId              String? @map("employee_id")
  locationId              String? @map("location_id")
  tableId                 String? @map("table_id")
  stripeCheckoutSessionId String? @map("stripe_checkout_session_id")

  rating       Int?     @db.SmallInt
  comment      String?  @db.Text
  tags         String[]
  customerName String?  @map("customer_name")
  /** Set when guest name is dropped on feedback completion (or leftover scrub). */
  nameAnonymizedAt DateTime? @map("name_anonymized_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("tip_feedback")
}

/// Platform SaaS subscription mirror (Phase A — table only; reads still use Business.subscriptionTier).
model Subscription {
  id                    String               @id @default(cuid())
  businessId            String               @unique @map("business_id")
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  planKey               SubscriptionPlanKey  @map("plan_key")
  billingCycle          BillingCycle         @default(monthly) @map("billing_cycle")
  status                SubscriptionStatus   @default(incomplete)

  /// Platform fee in cents (optional premium); null for basic tip-fees-only.
  platformFeeCents      Int?                 @map("platform_fee_cents")

  trialSource           TrialSource?         @map("trial_source")
  trialStartedAt        DateTime?            @map("trial_started_at")
  trialEndsAt           DateTime?            @map("trial_ends_at")
  /// True while Stripe status is trialing (synced from webhooks).
  isTrial               Boolean              @default(false) @map("is_trial")
  /// Tracks which trial reminder emails were sent, e.g. {"7":"2026-06-17T…","3":"…","1":"…"}.
  trialReminderSent     Json?                @map("trial_reminder_sent")
  /// Set when the subscription transitions from trialing to active (first successful charge).
  trialExpiredAt        DateTime?            @map("trial_expired_at")

  currentPeriodStart    DateTime?            @map("current_period_start")
  currentPeriodEnd      DateTime?            @map("current_period_end")
  renewalDate           DateTime?            @map("renewal_date")

  cancelAtPeriodEnd     Boolean              @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime?            @map("canceled_at")
  cancellationEffective DateTime?            @map("cancellation_effective")

  stripeCustomerId      String?              @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?              @unique @map("stripe_subscription_id")
  stripePriceId         String?              @map("stripe_price_id")

  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  events                SubscriptionEvent[]

  @@index([status])
  @@index([renewalDate])
  @@map("subscriptions")
}

/// Subscription lifecycle audit trail and future webhook idempotency (Phase A).
model SubscriptionEvent {
  id                String                            @id @default(cuid())
  subscriptionId    String?                           @map("subscription_id")
  subscription      Subscription?                     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  auditType         String                            @map("audit_type")
  type              String?                           @map("type")
  stripeEventId     String?                           @unique @map("stripe_event_id")

  processingResult  SubscriptionEventProcessingResult @map("processing_result")
  processingError   String?                           @map("processing_error")
  payload           Json?
  occurredAt        DateTime                          @default(now()) @map("occurred_at")
  processedAt       DateTime?                         @map("processed_at")

  @@index([subscriptionId, occurredAt])
  @@index([auditType, occurredAt])
  @@map("subscription_events")
}

/// Phase 3 — guest visit lifecycle (one visit → one scan).
enum QrGuestVisitStatus {
  active
  completed
  expired

  @@map("qr_guest_visit_status")
}

model QrGuestVisit {
  id          String             @id @default(cuid())
  businessId  String             @map("business_id")
  sessionId   String             @map("session_id") @db.VarChar(64)
  status      QrGuestVisitStatus @default(active)
  scanEventId String?            @unique @map("scan_event_id")
  scanType    String             @map("scan_type") @db.VarChar(32)
  employeeId  String?            @map("employee_id")
  locationId  String?            @map("location_id")
  tableId     String?            @map("table_id")
  qrSlug      String?            @map("qr_slug") @db.VarChar(128)
  entryPath   String             @map("entry_path") @db.VarChar(512)
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")
  expiresAt   DateTime           @map("expires_at")
  anonymizedAt DateTime?         @map("anonymized_at")

  business  Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scanEvent QrScanEvent? @relation(fields: [scanEventId], references: [id], onDelete: SetNull)

  @@index([businessId, sessionId, status])
  @@index([businessId, status])
  @@index([expiresAt])
  @@index([anonymizedAt])
  @@map("qr_guest_visits")
}

/// Sprint 4 — durable QR scan analytics (one row per attributed scan).
model QrScanEvent {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  employeeId String?  @map("employee_id")
  locationId String?  @map("location_id")
  tableId    String?  @map("table_id")
  qrSlug     String?  @map("qr_slug") @db.VarChar(128)
  scanType   String   @map("scan_type") @db.VarChar(32)
  entryPath  String   @map("entry_path") @db.VarChar(512)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  deviceType String   @map("device_type") @db.VarChar(32)
  country    String?  @db.VarChar(64)
  city       String?  @db.VarChar(128)
  scannedAt  DateTime @default(now()) @map("scanned_at")
  sessionId  String   @map("session_id") @db.VarChar(64)
  dedupeKey  String   @unique @map("dedupe_key") @db.VarChar(191)
  anonymizedAt DateTime? @map("anonymized_at")

  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee   Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location   Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  table      Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestVisit QrGuestVisit?

  @@index([businessId, scannedAt(sort: Desc)])
  @@index([employeeId, scannedAt(sort: Desc)])
  @@index([locationId, scannedAt(sort: Desc)])
  @@index([tableId, scannedAt(sort: Desc)])
  @@index([anonymizedAt])
  @@map("qr_scan_events")
}

/// Sprint 4F — conversion funnel foundation (tip_started, payment_completed). Not exposed in UI yet.
model QrFunnelEvent {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  sessionId     String   @map("session_id") @db.VarChar(64)
  eventType     String   @map("event_type") @db.VarChar(32)
  employeeId    String?  @map("employee_id")
  locationId    String?  @map("location_id")
  tableId       String?  @map("table_id")
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")
  anonymizedAt  DateTime? @map("anonymized_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([anonymizedAt])
  @@map("qr_funnel_events")
}

/// Sprint 7B — daily feature utilization rollups per business.
model FeatureUtilizationDaily {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureKey String   @map("feature_key") @db.VarChar(48)
  day        DateTime @db.Date
  hitCount   Int      @default(1) @map("hit_count")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@unique([businessId, featureKey, day])
  @@index([businessId, day])
  @@map("feature_utilization_daily")
}

/// Activity Center SSOT — operational event projection (feed never joins domain tables at read time).
model BusinessActivityEvent {
  id               String                @id @default(cuid())
  businessId       String                @map("business_id")
  type             String                @db.VarChar(64)
  source           ActivityEventSource
  priority         ActivityEventPriority @default(NORMAL)
  occurredAt       DateTime              @map("occurred_at")
  actorEmployeeId  String?               @map("actor_employee_id")
  actorUserId      String?               @map("actor_user_id")
  locationId       String?               @map("location_id")
  tableId          String?               @map("table_id")
  subjectType      String?               @map("subject_type") @db.VarChar(32)
  subjectId        String?               @map("subject_id") @db.VarChar(64)
  dedupeKey        String                @map("dedupe_key") @db.VarChar(191)
  summary          Json
  createdAt        DateTime              @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dedupeKey])
  @@index([businessId, occurredAt(sort: Desc)])
  @@index([businessId, source, occurredAt(sort: Desc)])
  @@index([businessId, type, occurredAt(sort: Desc)])
  @@map("business_activity_events")
}

/// Stripe refund / chargeback / dispute ledger (platform admin finance SSOT).
/// Never derive these rows from tip status=failed — failed payment ≠ refund.
enum TipRefundKind {
  refund
  chargeback
  dispute
}

enum TipRefundStatus {
  pending
  succeeded
  failed
  canceled
  needs_response
  won
  lost
}

model TipRefund {
  id                      String          @id @default(cuid())
  businessId              String          @map("business_id")
  tipId                   String?         @map("tip_id")
  stripeRefundId          String?         @unique @map("stripe_refund_id")
  stripePaymentIntentId   String?         @map("stripe_payment_intent_id")
  stripeChargeId          String?         @map("stripe_charge_id")
  stripeDisputeId         String?         @unique @map("stripe_dispute_id")
  kind                    TipRefundKind
  status                  TipRefundStatus @default(pending)
  amountEur               Decimal         @map("amount_eur") @db.Decimal(10, 2)
  currency                String          @default("eur") @db.VarChar(8)
  reason                  String?         @db.VarChar(120)
  /** Original tip amount when tip row is known (supports partial refund display). */
  originalAmountEur       Decimal?        @map("original_amount_eur") @db.Decimal(10, 2)
  occurredAt              DateTime        @map("occurred_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  /// Slice D.1: Restrict — refund ledger must not cascade-wipe with Business.
  business Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Slice D: optional tip link — SetNull if tip row later detached/deleted.
  tip        Transaction? @relation(fields: [tipId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt(sort: Desc)])
  @@index([stripePaymentIntentId])
  @@index([kind, status])
  @@index([tipId])
  @@map("tip_refunds")
}

enum LegalDocumentType {
  privacy_policy
  terms_conditions
  impressum
}

/// Provider-managed legal documents (privacy, terms, impressum). One row per type + language.
model LegalDocument {
  id          String            @id @default(cuid())
  type        LegalDocumentType
  language    String            @default("en") @db.VarChar(8)
  title       String
  contentHtml String            @map("content_html")
  version     String            @db.VarChar(64)
  updatedAt   DateTime          @updatedAt @map("updated_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([type, language])
  @@map("legal_documents")
}

/// Outbox for GDPR lifecycle jobs (Slice C expand — workers in later slices).
model DataLifecycleJob {
  id          String                   @id @default(cuid())
  type        DataLifecycleJobType
  status      DataLifecycleJobStatus   @default(pending)
  subjectType String                   @map("subject_type") @db.VarChar(32)
  subjectId   String                   @map("subject_id") @db.VarChar(64)
  payload     Json?
  notBefore   DateTime                 @default(now()) @map("not_before")
  attempts    Int                      @default(0)
  lastError   String?                  @map("last_error") @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  completedAt DateTime?                @map("completed_at")

  @@index([status, notBefore])
  @@index([subjectType, subjectId])
  @@map("data_lifecycle_jobs")
}

enum PhysicalQrContextType {
  storefront
  employee
  table
  location
}

enum PhysicalQrProcessingClass {
  SAME_DAY
  WITHIN_24_HOURS
}

enum PhysicalQrPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PhysicalQrFulfillmentStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

/// Platform-managed physical CareTip print catalogue. Price stays null until officially supplied.
model PhysicalQrProduct {
  id              String   @id
  name            String
  description     String   @db.Text
  templateId      String   @map("template_id") @db.VarChar(64)
  previewAsset    String?  @map("preview_asset")
  supportsAddress Boolean  @map("supports_address")
  active          Boolean  @default(true)
  orderable       Boolean  @default(false)
  /// Official unit price in EUR cents. Null = blocked; never invent a value.
  priceCents      Int?     @map("price_cents")
  currency        String   @default("EUR") @db.VarChar(3)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  orders          PhysicalQrOrder[]
  orderItems      PhysicalQrOrderItem[]

  @@map("physical_qr_products")
}

model PhysicalQrOrder {
  id                      String                       @id @default(cuid())
  businessId              String                       @map("business_id")
  userId                  String                       @map("user_id")
  /// Legacy denormalized first-line fields; multi-item orders use `items`.
  productId               String?                      @map("product_id")
  qrContextType           PhysicalQrContextType?       @map("qr_context_type")
  qrSubjectId             String?                      @map("qr_subject_id")
  qrTargetUrlSnapshot     String?                      @map("qr_target_url_snapshot") @db.Text
  quantity                Int                          @default(0)
  unitPrice               Int                          @default(0) @map("unit_price")
  totalAmount             Int                          @map("total_amount")
  /// Albertina package/quota breakdown (included prints, extras, totals). Source of truth with totalAmount.
  pricingSnapshot         Json?                        @map("pricing_snapshot")
  monthlyFreeQuotaApplied Boolean                      @default(false) @map("monthly_free_quota_applied")
  currency                String                       @db.VarChar(3)
  placedAt                DateTime                     @map("placed_at")
  processingClass         PhysicalQrProcessingClass    @map("processing_class")
  processingDeadlineAt    DateTime                     @map("processing_deadline_at")
  processingCopySnapshot  Json                         @map("processing_copy_snapshot")
  addressSnapshot         Json?                        @map("address_snapshot")
  /// Parcel destination frozen at place-order. Never backfilled from live profile.
  shippingSnapshot        Json?                        @map("shipping_snapshot")
  /// Contact frozen at place-order. Independent of printed addressSnapshot.
  contactSnapshot         Json?                        @map("contact_snapshot")
  colorTokensSnapshot     Json?                        @map("color_tokens_snapshot")
  businessNameSnapshot    String                       @map("business_name_snapshot") @db.VarChar(160)
  paymentStatus           PhysicalQrPaymentStatus      @default(PENDING) @map("payment_status")
  fulfillmentStatus       PhysicalQrFulfillmentStatus  @default(PENDING_PAYMENT) @map("fulfillment_status")
  stripeCheckoutSessionId String?                      @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?                      @map("stripe_payment_intent_id")
  carrier                 String?
  trackingNumber          String?                      @map("tracking_number")
  trackingUrl             String?                      @map("tracking_url") @db.Text
  paidAt                  DateTime?                    @map("paid_at")
  processingAt            DateTime?                    @map("processing_at")
  printingAt              DateTime?                    @map("printing_at")
  shippedAt               DateTime?                    @map("shipped_at")
  deliveredAt             DateTime?                    @map("delivered_at")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")

  business      Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user          User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  product       PhysicalQrProduct?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  items         PhysicalQrOrderItem[]
  messages      PhysicalQrOrderMessage[]
  internalNotes PhysicalQrOrderInternalNote[]

  @@index([businessId, placedAt(sort: Desc)])
  @@index([fulfillmentStatus, placedAt(sort: Desc)])
  @@index([paymentStatus])
  @@map("physical_qr_orders")
}

/// One row per QR destination in a parent physical QR order.
model PhysicalQrOrderItem {
  id                  String                @id @default(cuid())
  orderId             String                @map("order_id")
  productId           String                @map("product_id")
  qrContextType       PhysicalQrContextType @map("qr_context_type")
  qrSubjectId         String?               @map("qr_subject_id")
  qrTargetUrlSnapshot String                @map("qr_target_url_snapshot") @db.Text
  labelSnapshot       String                @map("label_snapshot") @db.VarChar(200)
  locationId          String?               @map("location_id")
  locationNameSnapshot String?              @map("location_name_snapshot") @db.VarChar(160)
  quantity            Int
  unitPrice           Int                   @map("unit_price")
  totalAmount         Int                   @map("total_amount")
  addressSnapshot     Json?                 @map("address_snapshot")
  colorTokensSnapshot Json                  @map("color_tokens_snapshot")
  createdAt           DateTime              @default(now()) @map("created_at")

  order   PhysicalQrOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product PhysicalQrProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("physical_qr_order_items")
}

/// Order-specific thread between platform fulfillment and the business. Never mix with internal notes.
model PhysicalQrOrderMessage {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  authorUserId String?  @map("author_user_id")
  /// `business` or `admin`
  authorRole   String   @map("author_role") @db.VarChar(16)
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  order  PhysicalQrOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User?           @relation("PhysicalQrOrderMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("physical_qr_order_messages")
}

/// Fulfillment-only notes. Must never be returned on business order APIs.
model PhysicalQrOrderInternalNote {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  authorUserId String?  @map("author_user_id")
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  order  PhysicalQrOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User?           @relation("PhysicalQrOrderNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("physical_qr_order_internal_notes")
}

