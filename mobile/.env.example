# CareTip Mobile — copy to `.env` for local development.
# Expo public vars must be prefixed with EXPO_PUBLIC_.
# Restart Expo after changing these values (`npx expo start -c`).
# Never commit real `.env`, `.env.staging`, or `.env.production` files.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Backend API origin (no trailing slash). Same SSOT as web VITE_API_URL.
# Physical device / Expo Go → PC LAN IP (phone cannot reach localhost on your PC):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3001
# Android emulator → host machine: http://10.0.2.2:3001
# iOS simulator / web: http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional: public web origin (deep links / marketing / legal links)
EXPO_PUBLIC_APP_URL=http://localhost:5173

# Request timeout (ms)
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Optional: EAS project UUID (from `eas init` / Expo dashboard). Required for push in standalone builds.
# EXPO_PUBLIC_EAS_PROJECT_ID=
