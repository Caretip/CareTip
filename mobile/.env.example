# CareTip Mobile — copy to `.env` for local development.
# Expo public vars must be prefixed with EXPO_PUBLIC_.
# Restart Expo after changing these values (`npx expo start -c`).
# Never commit real `.env`, `.env.staging`, or `.env.production` files.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Backend API origin (no trailing slash). Same SSOT as web VITE_API_URL.
# Physical device / Expo Go → PC LAN IP (phone cannot reach localhost on your PC):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3001
# Android emulator → host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# iOS device (EAS build) → staging/production HTTPS URL, or LAN IP for preview-lan profile
EXPO_PUBLIC_API_URL=http://localhost:3001

# Request timeout (ms)
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Optional: public web app origin for legal links, register, and social fallbacks (no trailing slash).
# EXPO_PUBLIC_APP_URL=https://caretip.de

# ── EAS (required for iOS cloud builds, push tokens, OTA updates) ──────────
# Run `eas init` in mobile/ then copy the project UUID here and as an EAS secret.
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid

# ── Google OAuth (required for native Google Sign-In on Android + iOS) ───────
# Same web client ID as VITE_GOOGLE_CLIENT_ID / GOOGLE_CLIENT_IDS on backend.
# Register Android OAuth clients in Google Cloud Console:
#   • de.caretip.app      — preview + production EAS builds
#   • de.caretip.app.dev  — development EAS builds (separate dev client on device)
# Use each package's SHA-1 from `eas credentials` for the matching profile.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Optional: explicit reversed iOS URL scheme (auto-derived from EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID).
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-prefix

# ── Facebook Login (native) — public App ID + Client Token only ──────────────
# Same App ID as VITE_FACEBOOK_APP_ID / backend FACEBOOK_APP_ID.
# Client Token: Meta Developer → App → Settings → Advanced (NOT the App Secret).
# FACEBOOK_APP_SECRET must never be set here — it belongs on the API only.
# After setting these, rebuild a custom/dev client (`expo prebuild` / EAS). Expo Go cannot load the SDK.
# EXPO_PUBLIC_FACEBOOK_APP_ID=1234567890
# EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=your-public-client-token

# ── Apple Sign In (Android web OAuth; iOS stays native) ───────────────────────
# Public Services ID only — same value as VITE_APPLE_CLIENT_ID / APPLE_CLIENT_ID.
# Do not put Apple private keys, Key IDs, or Team IDs in EXPO_PUBLIC_* or this file.
# Register HTTPS Return URL on that existing Services ID (do not create a new one):
#   {EXPO_PUBLIC_API_URL}/api/auth/apple/native-callback
# EXPO_PUBLIC_APPLE_CLIENT_ID=your.existing.services.id

# ── EAS Build secrets (set via `eas secret:create`, not in committed .env) ───
# For production/staging EAS builds, set in eas.json or EAS secrets:
#   EXPO_PUBLIC_API_URL=<API_BASE_URL>
#   EXPO_PUBLIC_APP_URL=<APP_BASE_URL>
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...
#   EXPO_PUBLIC_FACEBOOK_APP_ID=...
#   EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=...
#   EXPO_PUBLIC_APPLE_CLIENT_ID=...
#   EXPO_PUBLIC_EAS_PROJECT_ID=...

# Optional: social profile URLs (auth footer sheet). Falls back to /contact when unset.
# EXPO_PUBLIC_SOCIAL_FACEBOOK_URL=
# EXPO_PUBLIC_SOCIAL_INSTAGRAM_URL=
# EXPO_PUBLIC_SOCIAL_TIKTOK_URL=
# EXPO_PUBLIC_SOCIAL_LINKEDIN_URL=

# Idle session timeout (mirrors web VITE_IDLE_SESSION_TIMEOUT_ENABLED). Default off.
# EXPO_PUBLIC_IDLE_SESSION_TIMEOUT_ENABLED=true
