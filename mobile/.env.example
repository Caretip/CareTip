# CareTip Mobile — copy to `.env` for local development.
# Expo public vars must be prefixed with EXPO_PUBLIC_.
# Restart Expo after changing these values (`npx expo start -c`).
# Never commit real `.env`, `.env.staging`, or `.env.production` files.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Backend API origin (no trailing slash). Same SSOT as web VITE_API_URL.
# Physical device / Expo Go → PC LAN IP (phone cannot reach localhost on your PC):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3001
# Android emulator → host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# iOS simulator / web: http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Request timeout (ms)
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Optional: public web app origin for legal links, register, and social fallbacks (no trailing slash).
# EXPO_PUBLIC_APP_URL=https://caretip.de

# Google OAuth — same web client ID as VITE_GOOGLE_CLIENT_ID / GOOGLE_CLIENT_IDS on backend.
# Required for native Google Sign-In (ID token flow). Register Android SHA-1 + iOS bundle in Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Optional: social profile URLs (auth footer sheet). Falls back to /contact when unset.
# EXPO_PUBLIC_SOCIAL_FACEBOOK_URL=
# EXPO_PUBLIC_SOCIAL_INSTAGRAM_URL=
# EXPO_PUBLIC_SOCIAL_TIKTOK_URL=
# EXPO_PUBLIC_SOCIAL_LINKEDIN_URL=
