{
  "name": "caretip-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start -c",
    "android": "node scripts/run-android.mjs",
    "android:direct": "expo run:android",
    "android:win": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android-windows.ps1",
    "prebuild:android": "expo prebuild --platform android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:share": "npx tsx scripts/share-service-runtime.ts",
    "test:rate-limit": "npx tsx scripts/rate-limit-amplification-runtime.ts",
    "test:stats-scope": "npx tsx scripts/business-stats-scope-regression.ts",
    "test:splash": "npx tsx scripts/splash-handoff-runtime.ts",
    "test:billing-handoff": "npx tsx scripts/billing-handoff-runtime.ts",
    "test:auth-epoch": "npx tsx scripts/auth-session-epoch-runtime.ts",
    "test:logout-transition": "npx tsx scripts/logout-transition-runtime.ts",
    "test:brand-cta": "npx tsx scripts/brand-cta-runtime.ts",
    "generate:splash": "node scripts/generate-splash-native.mjs",
    "test:mobile-runtime": "npm run test:rate-limit && npm run test:stats-scope && npm run test:share && npm run test:splash && npm run test:billing-handoff && npm run test:auth-epoch && npm run test:logout-transition && npm run test:brand-cta",
    "lint": "expo lint",
    "eas:init": "eas init",
    "eas:login": "eas login",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:preview-lan:android": "eas build --profile preview-lan --platform android",
    "eas:build:preview-lan:ios": "eas build --profile preview-lan --platform ios",
    "eas:build:preview:ios": "eas build --profile preview --platform ios",
    "eas:build:production": "eas build --profile production --platform all",
    "eas:build:production:ios": "eas build --profile production --platform ios",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "eas:update:preview": "eas update --channel preview",
    "eas:update:production": "eas update --channel production",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.5.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "~14.0.0",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.0",
    "lucide-react-native": "^1.27.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.83.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
