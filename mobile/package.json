{
  "name": "caretip-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "eas:init": "eas init",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:preview-lan:android": "eas build --profile preview-lan --platform android",
    "eas:build:preview:ios": "eas build --profile preview --platform ios",
    "eas:build:production": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.5.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.0",
